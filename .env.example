# ==============================================================================
# MANDATE - The Financial Control & Security Layer for AI Agents
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- PayPal Developer Platform (Sandbox) ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- Google Gemini AI Engine ---
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Channel3 Product Discovery (Optional) ---
# If omitted, MANDATE uses the built-in authentic photography demonstration catalogue
CHANNEL3_API_KEY=your_channel3_api_key

# --- Supabase PostgreSQL (Optional for Production Deployments) ---
# When omitted, MANDATE uses high-speed persistent in-memory repository with atomic reservations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Application Host Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

