# ==============================================================================
# MANDATE - The Financial Control & Security Layer for AI Agents
# Environment Configuration Template (.env.example)
#
# Copy this file to .env.local and populate with your own sandbox/API credentials.
# Do NOT commit .env.local or any file containing live credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Platform (Sandbox REST API v2)
# Obtain credentials from https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
# Your Sandbox REST Application Client ID
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Your Sandbox REST Application Secret
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# PayPal REST API Endpoint (Default: https://api-m.sandbox.paypal.com)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID obtained after registering https://your-domain/api/webhooks/paypal
# in the PayPal Developer Dashboard under your REST Application
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Optional: Sandbox Business/Facilitator test account email (for documentation)
PAYPAL_SANDBOX_BUSINESS_ACCOUNT=merchant-facilitator@business.example.com

# Optional: Sandbox Personal/Buyer test account email (for documentation)
PAYPAL_SANDBOX_BUYER_ACCOUNT=buyer-personal@personal.example.com

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Engine
# Obtain an API key from https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# API Key for Gemini 2.5/3.5 models (Mandate Compiler & AI Risk Reviewer)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Specific Gemini model identifier (Defaults to gemini-3.5-flash-lite / gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Channel3 Product Discovery API (Optional)
# Obtain an API key from https://channel3.ai
# ------------------------------------------------------------------------------
# If omitted or unavailable, MANDATE smoothly falls back to its built-in
# authentic photography demonstration product catalogue.
CHANNEL3_API_KEY=your_channel3_api_key

# ------------------------------------------------------------------------------
# 4. Supabase PostgreSQL Configuration (Optional for Production Deployments)
# Obtain from https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Supabase project REST URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (used by frontend client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (server-only, bypasses RLS for immutable audit log writes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL / Transaction Pooler connection string
# Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# When omitted, MANDATE uses high-speed persistent in-memory repository with atomic reservations
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. Application Host & Runtime Configuration
# ------------------------------------------------------------------------------
# Fully qualified base URL of this application (no trailing slash).
# In development: http://localhost:3000
# In production (Render): https://your-service.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node execution environment (development | test | production)
NODE_ENV=development
